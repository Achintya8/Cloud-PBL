{
  "__inputs": [
    {
      "name": "DS_ARECA_RDS_POSTGRES",
      "label": "areca-rds-postgres",
      "description": "Areca Nut Price System — PostgreSQL RDS",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "table", "name": "Table", "version": ""},
    {"type": "panel", "id": "barchart", "name": "Bar chart", "version": ""}
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Areca Nut (Supari) Price Monitoring Dashboard — Karnataka APMC Markets. Tracks historical prices, market arrivals, ML-generated forecasts, and weather correlations.",
  "editable": true,
  "fiscalYearStartMonth": 3,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Chali — Latest Modal Price (₹/Qtl)",
      "description": "Most recently recorded wholesale modal price for Chali variety",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 35000},
              {"color": "green",  "value": 45000}
            ]
          },
          "unit": "currencyINR",
          "decimals": 0,
          "mappings": [],
          "custom": {"width": 200}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT NOW() AS time, AVG(modal_price) AS \"Chali Price\" FROM market_prices mp JOIN varieties v ON v.variety_id = mp.variety_id WHERE v.variety_name = 'Chali' AND mp.record_date = (SELECT MAX(record_date) FROM market_prices)",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0}
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Gotu — Latest Modal Price (₹/Qtl)",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 20000},
              {"color": "green",  "value": 28000}
            ]
          },
          "unit": "currencyINR",
          "decimals": 0,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT NOW() AS time, AVG(modal_price) AS \"Gotu Price\" FROM market_prices mp JOIN varieties v ON v.variety_id = mp.variety_id WHERE v.variety_name = 'Gotu' AND mp.record_date = (SELECT MAX(record_date) FROM market_prices)",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0}
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Active Markets Today",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT NOW() AS time, COUNT(DISTINCT market_id) AS \"Active Markets\" FROM market_prices WHERE record_date = (SELECT MAX(record_date) FROM market_prices)",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0}
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Total Arrivals Today (Tons)",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT NOW() AS time, COALESCE(SUM(arrivals_tons), 0) AS \"Total Arrivals\" FROM market_prices WHERE record_date = (SELECT MAX(record_date) FROM market_prices)",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0}
    },

    {
      "id": 5,
      "type": "stat",
      "title": "7-Day Price Change — Chali (%)",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "red",    "value": -5},
              {"color": "yellow", "value": -2},
              {"color": "green",  "value": 2}
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "WITH latest AS (SELECT AVG(modal_price) AS cur FROM market_prices mp JOIN varieties v ON v.variety_id=mp.variety_id WHERE v.variety_name='Chali' AND record_date=(SELECT MAX(record_date) FROM market_prices)), week_ago AS (SELECT AVG(modal_price) AS prev FROM market_prices mp JOIN varieties v ON v.variety_id=mp.variety_id WHERE v.variety_name='Chali' AND record_date=(SELECT MAX(record_date) FROM market_prices)-7) SELECT NOW() AS time, ROUND(((l.cur - w.prev)/NULLIF(w.prev,0)*100)::NUMERIC,2) AS \"7d Change %\" FROM latest l, week_ago w",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 0}
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Model Val RMSE (Latest Run)",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 2000},
              {"color": "red",    "value": 5000}
            ]
          },
          "unit": "currencyINR",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT NOW() AS time, COALESCE(val_rmse, 0) AS \"Model RMSE\" FROM model_training_runs WHERE status='success' ORDER BY completed_at DESC LIMIT 1",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 0}
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Historical Modal Price — All Varieties (₹/Quintal)",
      "description": "Daily aggregated modal price for each areca nut variety across all Karnataka APMC markets over the selected time range.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Price (₹/Qtl)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "currencyINR",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Chali"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#F5A623"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Gotu"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#7CB342"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Kotte"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#42A5F5"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["mean", "min", "max", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT record_date AS time, AVG(CASE WHEN v.variety_name='Chali'  THEN mp.modal_price END) AS \"Chali\", AVG(CASE WHEN v.variety_name='Gotu'   THEN mp.modal_price END) AS \"Gotu\",  AVG(CASE WHEN v.variety_name='Kotte'  THEN mp.modal_price END) AS \"Kotte\" FROM market_prices mp JOIN varieties v ON v.variety_id = mp.variety_id WHERE mp.record_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY record_date ORDER BY record_date",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 5}
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Price Forecast vs Actuals — Chali (7-Day Horizon)",
      "description": "Compares ML-predicted Chali prices (with 90% confidence band) against recorded actuals. Green shaded area = confidence interval.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Price (₹/Qtl)",
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "currencyINR",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Actual Price"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#F5A623"}},
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Predicted Price"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#00BCD4"}},
              {"id": "custom.lineStyle", "value": {"dash": [8, 4], "fill": "dash"}},
              {"id": "custom.lineWidth", "value": 2}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Confidence Lower"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "rgba(0,188,212,0.15)"}},
              {"id": "custom.fillBelowTo", "value": "Confidence Upper"},
              {"id": "custom.lineWidth", "value": 0}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Confidence Upper"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "rgba(0,188,212,0.15)"}},
              {"id": "custom.lineWidth", "value": 0}
            ]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT mp.record_date AS time, AVG(mp.modal_price) AS \"Actual Price\" FROM market_prices mp JOIN varieties v ON v.variety_id=mp.variety_id WHERE v.variety_name='Chali' AND mp.record_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY mp.record_date ORDER BY mp.record_date",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT pp.target_date AS time, AVG(pp.predicted_price) AS \"Predicted Price\", AVG(pp.confidence_lower) AS \"Confidence Lower\", AVG(pp.confidence_upper) AS \"Confidence Upper\" FROM price_predictions pp JOIN varieties v ON v.variety_id=pp.variety_id WHERE v.variety_name='Chali' AND pp.horizon_days=7 AND pp.target_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY pp.target_date ORDER BY pp.target_date",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 15}
    },

    {
      "id": 21,
      "type": "gauge",
      "title": "30-Day Forecast Confidence — Chali",
      "description": "Model confidence as a ratio of CI width to predicted price. Lower is better.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red",    "value": 20}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 30
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["mean"]},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT NOW() AS time, AVG(((confidence_upper-confidence_lower)/NULLIF(predicted_price,0))*100) AS \"CI Width %\" FROM price_predictions pp JOIN varieties v ON v.variety_id=pp.variety_id WHERE v.variety_name='Chali' AND pp.horizon_days=30 AND pp.prediction_date=(SELECT MAX(prediction_date) FROM price_predictions)",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 15}
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Daily Market Arrivals (Tons) — Top Markets",
      "description": "Supply volume trend across key areca nut mandis. High arrivals can signal price pressure.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Arrivals (Tons)",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {"mode": "none", "group": "A"}
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {"calcs": ["sum", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT mp.record_date AS time, SUM(CASE WHEN m.market_name='Shimoga'         THEN mp.arrivals_tons END) AS \"Shimoga\", SUM(CASE WHEN m.market_name='Sagara'           THEN mp.arrivals_tons END) AS \"Sagara\",  SUM(CASE WHEN m.market_name='Mudigere'         THEN mp.arrivals_tons END) AS \"Mudigere\", SUM(CASE WHEN m.market_name='Chikkamagaluru'   THEN mp.arrivals_tons END) AS \"Chikkamagaluru\" FROM market_prices mp JOIN markets m ON m.market_id=mp.market_id WHERE mp.record_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY mp.record_date ORDER BY mp.record_date",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 25}
    },

    {
      "id": 31,
      "type": "timeseries",
      "title": "Weather — Rainfall & Humidity (Shimoga Region)",
      "description": "Monsoon rainfall and humidity trends correlate strongly with areca nut yield and price. Heavy pre-harvest rain can inflate prices.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Rainfall (mm)"},
            "properties": [
              {"id": "unit", "value": "lengthmm"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#42A5F5"}},
              {"id": "custom.axisPlacement", "value": "left"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Avg Humidity (%)"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#26C6DA"}},
              {"id": "custom.axisPlacement", "value": "right"}
            ]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT w.record_date AS time, AVG(w.rainfall_mm) AS \"Rainfall (mm)\", AVG(w.avg_humidity) AS \"Avg Humidity (%)\" FROM weather_metrics w JOIN markets m ON m.market_id=w.region_id WHERE m.market_name='Shimoga' AND w.record_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY w.record_date ORDER BY w.record_date",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 25}
    },

    {
      "id": 40,
      "type": "table",
      "title": "Current Market Prices — All Varieties (Latest Trading Day)",
      "description": "Sortable table of latest modal prices across all markets and varieties.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {
            "align": "center",
            "displayMode": "auto",
            "filterable": true
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {"color": "red",    "value": null},
              {"color": "yellow", "value": 40},
              {"color": "green",  "value": 70}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "modal_price"},
            "properties": [
              {"id": "displayName", "value": "Modal Price (₹/Qtl)"},
              {"id": "unit", "value": "currencyINR"},
              {"id": "custom.displayMode", "value": "color-background"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "min_price"},
            "properties": [{"id": "displayName", "value": "Min (₹/Qtl)"}, {"id": "unit", "value": "currencyINR"}]
          },
          {
            "matcher": {"id": "byName", "options": "max_price"},
            "properties": [{"id": "displayName", "value": "Max (₹/Qtl)"}, {"id": "unit", "value": "currencyINR"}]
          },
          {
            "matcher": {"id": "byName", "options": "arrivals_tons"},
            "properties": [{"id": "displayName", "value": "Arrivals (Tons)"}]
          },
          {
            "matcher": {"id": "byName", "options": "market_name"},
            "properties": [{"id": "displayName", "value": "Market"}]
          },
          {
            "matcher": {"id": "byName", "options": "variety_name"},
            "properties": [{"id": "displayName", "value": "Variety"}]
          }
        ]
      },
      "options": {
        "sortBy": [{"displayName": "Modal Price (₹/Qtl)", "desc": true}],
        "footer": {"show": false}
      },
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
          "rawSql": "SELECT m.market_name, v.variety_name, mp.min_price, mp.max_price, mp.modal_price, mp.arrivals_tons, mp.source FROM market_prices mp JOIN markets m ON m.market_id=mp.market_id JOIN varieties v ON v.variety_id=mp.variety_id WHERE mp.record_date=(SELECT MAX(record_date) FROM market_prices) ORDER BY mp.modal_price DESC LIMIT 100",
          "refId": "A",
          "format": "table"
        }
      ],
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 35}
    },

    {
      "id": 50,
      "type": "timeseries",
      "title": "ML Model Training History — Validation RMSE Over Time",
      "description": "Tracks model accuracy improvements across training runs. Lower RMSE = more accurate forecasts.",
      "datasource": {"type": "postgres", "uid": "${DS_ARECA_RDS_POSTGRES}"},
      "fieldConfig": {
