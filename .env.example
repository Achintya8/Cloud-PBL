# Areca Nut Price Prediction System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to version control.

# ── Application ─────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=generate-a-strong-random-secret-here
CORS_ORIGINS=http://localhost:8080,http://0.0.0.0:8080
FRONTEND_PORT=8080
API_PORT=8000

# ── Database (RDS PostgreSQL) ────────────────────────────────
RDS_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=areca_db
RDS_USER=areca_admin
RDS_PASSWORD=your_very_secure_password_here
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── AWS Configuration ────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# EC2
EC2_INSTANCE_TYPE=t3.medium
EC2_AMI_ID=ami-0f58b397bc5c1f2e8
EC2_KEY_PAIR=areca-keypair

# RDS
RDS_IDENTIFIER=areca-price-db
RDS_INSTANCE_CLASS=db.t3.micro
RDS_ALLOCATED_STORAGE=20
RDS_ENGINE_VERSION=15.4
RDS_MULTI_AZ=false

# Lambda
LAMBDA_FUNCTION_NAME=areca-price-api
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512
LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/areca-lambda-execution-role

# API Gateway
API_GATEWAY_NAME=areca-price-api-gateway
API_STAGE=prod

# ── ETL Configuration ────────────────────────────────────────
SCRAPE_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=5
ETL_BATCH_SIZE=100

# Optional: OpenWeatherMap API key (open-meteo is used by default, no key needed)
WEATHER_API_KEY=

# ── Machine Learning ─────────────────────────────────────────
MODEL_PATH=/opt/areca/models/lgbm_areca.pkl
SCALER_PATH=/opt/areca/models/scaler.pkl
FEATURES_PATH=/opt/areca/models/features.json
MIN_TRAINING_ROWS=90
N_ESTIMATORS=500
LEARNING_RATE=0.05
NUM_LEAVES=63

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password

# ── Backend API URL (for frontend proxy) ─────────────────────
BACKEND_API_URL=http://localhost:8000/api/v1
